# Absolute path on the VM. Use a dedicated read-only OpsDeck kubeconfig,
# never an administrator's main ~/.kube/config.
OPSDECK_KUBECONFIG_HOST=/etc/opsdeck/kubeconfig

# Persistent SQLite audit database directory on the VM.
OPSDECK_DATA_DIR=/var/lib/opsdeck

# File containing a random operator token. Do not put the token itself here.
OPSDECK_ACTION_TOKEN_FILE_HOST=/etc/opsdeck/action-token

# Directory containing only the OpsDeck SSH private key and verified known_hosts.
OPSDECK_SSH_DIR_HOST=/etc/opsdeck/ssh
