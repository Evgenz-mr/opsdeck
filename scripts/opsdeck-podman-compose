#!/usr/bin/env bash
set -euo pipefail

OPSDECK_SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
OPSDECK_PROJECT_DIR=$(cd -- "$OPSDECK_SCRIPT_DIR/.." && pwd)
OPSDECK_ENV_FILE="$OPSDECK_PROJECT_DIR/.env"

if [[ ! -f "$OPSDECK_ENV_FILE" ]]; then
  echo "Missing $OPSDECK_ENV_FILE. Copy .env.example to .env and edit it." >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
source "$OPSDECK_ENV_FILE"
set +a

: "${OPSDECK_KUBECONFIG_HOST:?Set OPSDECK_KUBECONFIG_HOST in .env}"
: "${OPSDECK_DATA_DIR:?Set OPSDECK_DATA_DIR in .env}"

exec podman-compose \
  -t identity \
  -f "$OPSDECK_PROJECT_DIR/podman-compose.yml" \
  "$@"
